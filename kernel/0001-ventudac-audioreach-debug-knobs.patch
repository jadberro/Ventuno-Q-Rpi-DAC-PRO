+/* ---- VentuDAC debug: runtime-selectable PRM clock votes for LPI MI2S ports ---- */
+static int lpi_clk_id;		/* raw PRM clock id, e.g. 0x110 (INT1_MI2S_IBIT); 0 = off */
+module_param(lpi_clk_id, int, 0644);
+MODULE_PARM_DESC(lpi_clk_id, "PRM clock id to vote for LPI MI2S ports (0=off)");
+static int lpi_clk_freq;	/* Hz; 0 = auto (rate*ch*32) */
+module_param(lpi_clk_freq, int, 0644);
+static int lpi_clk_attr = 1;	/* 1 = COUPLE_NO */
+module_param(lpi_clk_attr, int, 0644);
+static int lpi_mclk_id;		/* optional second clock, e.g. 0x304 MCLK_5 */
+module_param(lpi_mclk_id, int, 0644);
+static int lpi_mclk_freq = 12288000;
+module_param(lpi_mclk_freq, int, 0644);
+static int lpi_port_mask = 0x3ff;	/* bit n -> LPI_MI2S_RX_0 + n */
+module_param(lpi_port_mask, int, 0644);
+static int lpi_voted_clk[APM_PORT_MAX], lpi_voted_mclk[APM_PORT_MAX];
+
+static struct device *ventudac_prm_dev(struct q6apm_lpass_dai_data *d)
+{
+	static struct device *cached;
+	struct device_node *np;
+	struct platform_device *pd;
+
+	if (d->cc)
+		return d->cc->dev;
+	if (cached)
+		return cached;
+	np = of_find_compatible_node(NULL, NULL, "qcom,q6prm-lpass-clocks");
+	if (!np)
+		return NULL;
+	pd = of_find_device_by_node(np);
+	of_node_put(np);
+	if (pd)
+		cached = &pd->dev;
+	return cached;
+}
+
+static void ventudac_lpi_vote(struct snd_soc_dai *dai, struct q6apm_lpass_dai_data *d,
+			      struct audioreach_module_config *cfg)
+{
+	struct device *pdev;
+	int id = dai->id, freq, rc;
+
+	if (id < LPI_MI2S_RX_0 || id > LPI_MI2S_TX_4 ||
+	    !(lpi_port_mask & BIT(id - LPI_MI2S_RX_0)))
+		return;
+	pdev = ventudac_prm_dev(d);
+	if (!pdev) {
+		dev_err(dai->dev, "ventudac: no PRM clock device\n");
+		return;
+	}
+	if (lpi_clk_id && !lpi_voted_clk[id]) {
+		freq = lpi_clk_freq ? lpi_clk_freq :
+			cfg->sample_rate * max_t(unsigned int, cfg->num_channels, 2) * 32;
+		rc = q6prm_set_lpass_clock(pdev, lpi_clk_id, lpi_clk_attr,
+					   Q6DSP_LPASS_CLK_ROOT_DEFAULT, freq);
+		dev_info(dai->dev, "ventudac: dai %d vote clk 0x%x @%d attr %d -> %d\n",
+			 id, lpi_clk_id, freq, lpi_clk_attr, rc);
+		if (!rc)
+			lpi_voted_clk[id] = lpi_clk_id;
+	}
+	if (lpi_mclk_id && !lpi_voted_mclk[id]) {
+		rc = q6prm_set_lpass_clock(pdev, lpi_mclk_id, 1,
+					   Q6DSP_LPASS_CLK_ROOT_DEFAULT, lpi_mclk_freq);
+		dev_info(dai->dev, "ventudac: dai %d vote mclk 0x%x @%d -> %d\n",
+			 id, lpi_mclk_id, lpi_mclk_freq, rc);
+		if (!rc)
+			lpi_voted_mclk[id] = lpi_mclk_id;
+	}
+}
+
+static void ventudac_lpi_unvote(struct snd_soc_dai *dai, struct q6apm_lpass_dai_data *d)
+{
+	struct device *pdev = ventudac_prm_dev(d);
+	int id = dai->id;
+
+	if (id < 0 || id >= APM_PORT_MAX || !pdev)
+		return;
+	if (lpi_voted_clk[id]) {
+		q6prm_set_lpass_clock(pdev, lpi_voted_clk[id], lpi_clk_attr,
+				      Q6DSP_LPASS_CLK_ROOT_DEFAULT, 0);
+		lpi_voted_clk[id] = 0;
+	}
+	if (lpi_voted_mclk[id]) {
+		q6prm_set_lpass_clock(pdev, lpi_voted_mclk[id], 1,
+				      Q6DSP_LPASS_CLK_ROOT_DEFAULT, 0);
+		lpi_voted_mclk[id] = 0;
+	}
 }
+/* ---- end VentuDAC ---- */
 
